{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Data produk dagangan untuk UMKM",
      "type": "object",
      "properties": {
        "namaProduk": { "type": "string" },
        "kategori": { "type": "string", "enum": ["Rokok", "Sembako", "Minuman", "Sachet", "Lainnya"] },
        "modal": { "type": "number" },
        "hargaJual": { "type": "number" },
        "stok": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["namaProduk", "kategori", "modal", "hargaJual", "stok"]
    }
  },
  "auth": {
    "providers": ["anonymous"]
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Koleksi produk global yang dapat diakses oleh pengguna anonim"
    }
  }
}
