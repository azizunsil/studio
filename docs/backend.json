
{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Data produk dagangan untuk UMKM di Realtime Database",
      "type": "object",
      "properties": {
        "namaBarang": { "type": "string" },
        "kategori": { "type": "string", "enum": ["Rokok", "Sembako", "Minuman", "Sachet", "Titipan", "Lainnya"] },
        "modal": { "type": "number" },
        "hargaJual": { "type": "number" },
        "stok": { "type": "number" },
        "stokAwalTitipan": { "type": "number", "description": "Hanya untuk kategori Titipan" },
        "lastStockUpdateAt": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["namaBarang", "kategori", "modal", "hargaJual", "stok"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Pengaturan aplikasi seperti target modal dan mode stock opname",
      "type": "object",
      "properties": {
        "modalTarget": { "type": "number" },
        "stockOpnameMode": { "type": "boolean" }
      }
    },
    "ModalAdjustment": {
      "title": "Modal Adjustment",
      "description": "Koreksi nilai modal dari roris sebelumnya",
      "type": "object",
      "properties": {
        "tanggal": { "type": "number" },
        "keterangan": { "type": "string" },
        "jenis": { "type": "string", "enum": ["Tambah", "Kurang"] },
        "nominal": { "type": "number" },
        "createdAt": { "type": "number" }
      }
    },
    "RorisLiability": {
      "title": "Roris Liability",
      "description": "Catatan tanggungan pengelola dari roris",
      "type": "object",
      "properties": {
        "tanggal": { "type": "number" },
        "pengelola": { "type": "string" },
        "keterangan": { "type": "string" },
        "jenis": { "type": "string", "enum": ["Tambah Tanggungan", "Bayar Tanggungan"] },
        "nominal": { "type": "number" },
        "createdAt": { "type": "number" }
      }
    }
  },
  "auth": {
    "providers": ["anonymous"]
  },
  "database": {
    "warungs/{warungId}/products": {
      "schema": "Product",
      "description": "Daftar produk usaha per toko"
    },
    "warungs/{warungId}/settings": {
      "schema": "Settings",
      "description": "Konfigurasi per toko"
    },
    "warungs/{warungId}/modalAdjustments": {
      "schema": "ModalAdjustment",
      "description": "Daftar ralat modal per toko"
    },
    "warungs/{warungId}/rorisLiabilities": {
      "schema": "RorisLiability",
      "description": "Daftar tanggungan roris per toko"
    }
  }
}
